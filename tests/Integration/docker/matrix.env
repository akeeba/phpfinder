# The PHP versions the integration suite runs against. Committed, never configured: run.sh sources this
# file, so every checkout on every machine tests the same thing. Use run.sh --php=X.Y for a one-off.
#
# Every version must be an akeeba-e2e/php tag allowed by ../../../../buildfiles/docker/e2e/versions
# (7.4 8.1 8.2 8.3 8.4 8.5 8.6 at the time of writing). composer.json allows PHP 7.2 to 8.6; there are
# no 7.2, 7.3 or 8.0 images, so those versions are NOT tested here.
#
# PHP_MATRIX (runner versions: the PHP which executes PHPFinder), oldest first:
#   7.4     the oldest available. PHP 7 semantics: strpos() with a null needle never matches, which is
#           what used to break getBestPath() without a version (see RunnerTest).
#   8.1     the first PHP to deprecate passing null to internal string parameters.
#   8.5     the day-to-day default.
#   8.6     the newest PHP composer.json allows, and the newest stable PHP.
PHP_MATRIX="7.4 8.1 8.5 8.6"

# What a plain run.sh (no --matrix) runs.
PHP_VERSION=8.5

# The extra, real PHP CLIs installed in the container as fixtures (see ../fixture/fixtures.txt). They
# must never include a runner version: the runner's /usr/local/bin/php would shadow the fixture.
DONOR_VERSIONS="8.2 8.3 8.4"
